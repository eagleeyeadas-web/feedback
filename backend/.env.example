# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Centralized 20-day automatic cleanup secret for scheduled external triggers (e.g. cron-job.org)
CRON_SECRET=your-secure-cron-secret-here

# Account Provisioning & Testing Passwords (optional, for scripts/provision_role_accounts.js and test suites)
SALES_ACCOUNT_PASSWORD=your-secure-sales-password
TECH_ACCOUNT_PASSWORD=your-secure-tech-password
STORE_ACCOUNT_PASSWORD=your-secure-store-password
COORDINATOR_ACCOUNT_PASSWORD=your-secure-coordinator-password
ADMIN_ACCOUNT_PASSWORD=your-secure-admin-password
